/home/_user_/logs/*.log {
    daily
    rotate 14
    maxsize 1M
    compress
    delaycompress
    missingok
    notifempty
    dateext
    su _user_ _user_
    create 0664 _user_ _user_
    sharedscripts
    postrotate
        if [ -s /run/nginx.pid ]; then
            /bin/kill -USR1 "$(/bin/cat /run/nginx.pid)"
        fi
    endscript
}
